{
  "version": 2,
  "builds": [
    { "src": "frontend/api/chat.js", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}