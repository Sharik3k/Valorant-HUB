# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys

# Option 1: Set API key here for development (NOT RECOMMENDED for production)
# VITE_OPENROUTER_API_KEY=your_api_key_here

# Option 2: Users can set their own API key in the app settings (RECOMMENDED)
# Leave this empty and users will configure their keys in the UI

# OpenRouter API URL (default)
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# App Info (for OpenRouter analytics)
VITE_APP_NAME=Valorant-HUB
VITE_APP_URL=https://sharik3k.github.io/Valorant-HUB

# Default AI Model
VITE_DEFAULT_AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
