# ======================================
# VALORANT HUB - Frontend Environment Variables
# ======================================

# 🐍 Django Backend URL
# Для локальної розробки: http://localhost:8000
# Для продакшену: https://your-app.railway.app
VITE_DJANGO_BACKEND_URL=http://localhost:8000

# 🌐 КЛІЄНТСЬКІ ЗМІННІ (з префіксом VITE_)
# Ці змінні доступні в браузері (не секретні!)

# Default AI Model для клієнта
VITE_DEFAULT_AI_MODEL=meta-llama/llama-3.2-3b-instruct:free

# 🤖 OpenRouter API Configuration
# Отримайте безкоштовний API ключ на https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Безкоштовні моделі на OpenRouter:
# - meta-llama/llama-3.2-3b-instruct:free
# - google/gemini-2.0-flash-exp:free
# - microsoft/phi-3-mini-128k-instruct:free
# - qwen/qwen-2-7b-instruct:free
VITE_AI_MODEL=meta-llama/llama-3.2-3b-instruct:free
