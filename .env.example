# ======================================
# VALORANT HUB - Frontend Environment Variables
# ======================================

# 🐍 Django Backend URL
# Для локальної розробки: http://localhost:8000
# Для продакшену: https://your-app.railway.app
VITE_DJANGO_BACKEND_URL=http://localhost:8000

# 🌐 КЛІЄНТСЬКІ ЗМІННІ (з префіксом VITE_)
# Ці змінні доступні в браузері (не секретні!)

# Default AI Model для клієнта
VITE_DEFAULT_AI_MODEL=openai/gpt-4o

# 🤖 Google Gemini API Configuration (СЕРВЕРНІ ЗМІННІ - БЕЗ VITE_)
# 🔒 БЕЗ VITE_ префіксу = API ключ НЕ доступний в браузері (безпечно!)
# Ці змінні використовуються тільки в Vercel Serverless Functions

# Отримайте безкоштовний API ключ на https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Доступні моделі Gemini (всі безкоштовні):
# - gemini-2.0-flash-exp (рекомендовано - найшвидша і найновіша)
# - gemini-1.5-flash (стабільна)
# - gemini-1.5-pro (найрозумніша, але повільніша)
AI_MODEL=gemini-2.0-flash-exp
