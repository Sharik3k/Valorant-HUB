# ======================================
# Django Backend - Environment Variables
# ======================================

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.railway.app

# CORS Settings (frontend URLs)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# 🔒 OpenRouter API (ЗАХИЩЕНО на сервері!)
OPENROUTER_API_KEY=sk-or-v1-your_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# App Info
APP_NAME=Valorant-HUB
APP_URL=https://your-frontend.vercel.app

# AI Model Settings
DEFAULT_AI_MODEL=meta-llama/llama-3.2-3b-instruct:free
