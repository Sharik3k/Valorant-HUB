# OpenRouter API Key (for chat with best free models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# AI Model (default: google/gemini-2.0-flash-exp:free)
# Alternatives: meta-llama/llama-3.3-70b-instruct:free, google/gemini-pro-1.5-exp:free
AI_MODEL=google/gemini-2.0-flash-exp:free

# Gemini API Key (for embeddings only)
GEMINI_API_KEY=your-gemini-api-key-here

PORT=3001
