# OpenRouter API Key (for chat with best free models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# AI Model (default: meta-llama/llama-3.2-3b-instruct:free - most stable)
# Alternatives: meta-llama/llama-3.2-1b-instruct:free, google/gemini-2.0-flash-exp:free
AI_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Gemini API Key (for embeddings only)
GEMINI_API_KEY=your-gemini-api-key-here

PORT=3001
